/* ========== 登录页面 ========== */
.myLogin {
  min-height: 420rpx;
  background-color: #1a5f9e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0 50rpx;
}

/* 已登录用户头像 */
.myLogin .user-avatar {
  height: 140rpx;
  width: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
}

.myLogin .nickname {
  color: #fff;
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.myLogin .login-type {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

/* 退出登录按钮 */
.logout-btn {
  margin-top: 28rpx;
  padding: 12rpx 50rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 32rpx;
}

/* 登录区域 */
.login-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 头像占位 */
.avatar-placeholder {
  margin-bottom: 24rpx;
}

.avatar-placeholder .avatar-emoji {
  font-size: 120rpx;
  opacity: 0.6;
}

/* 提示文字 */
.login-hint {
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
  margin-bottom: 36rpx;
}

/* 登录按钮组 */
.login-buttons {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  gap: 14rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.login-btn::after {
  display: none;
}

.wx-login-btn {
  background-color: #07c160;
  color: #fff;
}

.btn-emoji {
  font-size: 36rpx;
  line-height: 84rpx;
}

.btn-text {
  line-height: 84rpx;
}

/* ========== 微信信息填写页 ========== */
.wx-profile-page {
  background-color: #fff;
  margin-top: 16rpx;
  padding: 0 30rpx;
}

.profile-header {
  padding: 36rpx 0 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #eef1f3;
}

.profile-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}

.profile-form {
  padding: 20rpx 0;
}

.profile-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-label {
  font-size: 30rpx;
  color: #333;
  width: 140rpx;
  flex-shrink: 0;
}

/* 头像选择按钮 */
.avatar-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: none;
  border: none;
  padding: 0;
  margin-left: auto;
  line-height: normal;
  height: auto;
}

.avatar-btn::after {
  display: none;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
}

.avatar-select-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #f0f2f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.avatar-tip {
  font-size: 26rpx;
  color: #999;
}

/* 昵称输入 */
.nickname-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  padding-right: 10rpx;
}

/* 底部按钮 */
.profile-footer {
  display: flex;
  gap: 20rpx;
  padding: 40rpx 0 50rpx;
}

.profile-cancel {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  background-color: #f5f7fa;
  color: #666;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.profile-cancel::after {
  display: none;
}

.profile-confirm {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  background-color: #1a5f9e;
  color: #fff;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.profile-confirm::after {
  display: none;
}

/* ========== 收藏列表 ========== */
.myFavorite {
  background-color: #fff;
  margin-top: 16rpx;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 120rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #bbb;
}
