/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
}

.my-image {
  width: 100%;
  height: 400rpx;
  margin-top: 20rpx;
}

.name-text {
  display: block;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #ff69b4;
  margin-top: 24rpx;
  margin-bottom: 32rpx;
}

.toggle-btn {
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
  margin: 0 auto;
}
